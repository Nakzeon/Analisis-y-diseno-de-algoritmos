n <- as.numeric(readline("Introduce el tamaño del arreglo: "))
vector_al <- function(n, min = 1, max = 10000000000) {
# Genera n números aleatorios entre min y max
vector <- sample(min:max, n, replace = TRUE)
return(vector)
}
n <- as.numeric(readline("Introduce el tamaño del arreglo: "))
arreglo <- vector_al(n)
n <- as.numeric(readline("Introduce el tamaño del arreglo: "))
arreglo <- vector_al(n)
print(arreglo)
